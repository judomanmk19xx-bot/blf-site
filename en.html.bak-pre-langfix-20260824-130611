<style>
:root {
  --navy: #0F2B48;
  --navy-dark: #0A2540;
  --teal: #15697A;
  --teal-hover: #0e5563;
  --bg-white: #FFFFFF;
  --bg-warm: #F6F5F0;
  --bg-cool: #F8F9FA;
  --text-main: #222222;
  --text-sub: #666666;
  --border: #E5E5E5;
  --font-serif: 'Noto Serif JP', serif;
  --font-sans: 'Noto Sans JP', sans-serif;
  --font-en: 'Montserrat', sans-serif;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; font-size: 16px; }
body { font-family: var(--font-sans); color: var(--text-main); line-height: 1.9; background: var(--bg-white); -webkit-font-smoothing: antialiased; }
img { max-width: 100%; height: auto; display: block; object-fit: cover; }
a { text-decoration: none; color: inherit; transition: all 0.3s ease; }

/* === TYPOGRAPHY === */
.section-title {
  font-family: var(--font-serif);
  font-size: clamp(1.8rem, 3vw, 2.4rem);
  font-weight: 700;
  color: var(--navy);
  text-align: center;
  margin-bottom: 0.75rem;
  letter-spacing: 0.04em;
  position: relative;
  padding-bottom: 1.25rem;
}
.section-title::after {
  content: '';
  display: block;
  width: 50px;
  height: 3px;
  background: var(--navy);
  margin: 0 auto;
}
.section-subtitle {
  text-align: center;
  color: var(--text-sub);
  margin-bottom: 3.5rem;
  font-size: 1rem;
  letter-spacing: 0.02em;
  line-height: 1.8;
}
.container { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
section { padding: 100px 0; }

/* === BUTTONS === */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 36px;
  border-radius: 9999px;
  font-family: var(--font-sans);
  font-weight: 600;
  font-size: 0.9rem;
  cursor: pointer;
  transition: all 0.3s ease;
  border: 2px solid transparent;
  letter-spacing: 0.03em;
}
.btn-navy { background: var(--navy); color: #fff; border-color: var(--navy); }
.btn-navy:hover { background: var(--navy-dark); border-color: var(--navy-dark); transform: translateY(-2px); box-shadow: 0 4px 12px rgba(15,43,72,0.2); }
.btn-outline { background: transparent; color: var(--navy); border-color: var(--navy); }
.btn-outline:hover { background: var(--navy); color: #fff; transform: translateY(-2px); }
.btn-teal { background: var(--teal); color: #fff; border-color: var(--teal); }
.btn-teal:hover { background: var(--teal-hover); border-color: var(--teal-hover); transform: translateY(-2px); }
.btn-white { background: #fff; color: var(--navy); border-color: #fff; }
.btn-white:hover { background: var(--bg-cool); transform: translateY(-2px); }
.btn-arrow::after { content: '›'; font-size: 1.3em; line-height: 1; margin-left: 4px; }

/* === HEADER === */
header {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  background: rgba(255,255,255,0.98);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}
.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 32px;
}
.logo { display: flex; align-items: center; gap: 14px; }
.logo-mark {
  width: 44px; height: 44px;
  background: var(--navy);
  transform: rotate(45deg);
  display: flex; align-items: center; justify-content: center;
  border-radius: 6px;
  flex-shrink: 0;
}
.logo-mark span { transform: rotate(-45deg); color: #fff; font-family: var(--font-en); font-size: 13px; font-weight: 700; letter-spacing: 1.5px; }
.logo-text { font-family: var(--font-en); font-size: 0.8rem; letter-spacing: 0.5px; line-height: 1.3; color: var(--navy); font-weight: 600; }
.logo-text small { display: block; font-size: 0.6rem; font-weight: 400; color: var(--text-sub); letter-spacing: 0.3px; margin-top: 2px; }

nav { display: flex; align-items: center; gap: 32px; }
nav a { font-size: 0.82rem; font-weight: 500; color: var(--text-main); letter-spacing: 0.02em; position: relative; }
nav a::after { content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 2px; background: var(--teal); transition: width 0.3s; }
nav a:hover { color: var(--teal); }
nav a:hover::after { width: 100%; }

.header-right { display: flex; align-items: center; gap: 20px; }
.lang-switch { font-family: var(--font-en); font-size: 0.78rem; color: var(--text-sub); display: flex; gap: 10px; letter-spacing: 0.5px; }
.lang-switch .active { color: var(--navy); font-weight: 700; }
.header-cta { padding: 10px 28px; font-size: 0.82rem; }

.mobile-toggle { display: none; background: none; border: none; font-size: 1.5rem; color: var(--navy); cursor: pointer; padding: 8px; }

/* === HERO === */
.hero {
  position: relative;
  min-height: 680px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #fff;
  padding: 160px 24px 120px;
  overflow: hidden;
}
.hero-bg {
  position: absolute; inset: 0; z-index: 0;
  background: url('images/thay_chon/tea_picker_cc0.jpg') center/cover no-repeat;
}
.hero-bg::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(10,37,64,0.75) 0%, rgba(15,43,72,0.85) 50%, rgba(10,37,64,0.9) 100%);
}
.hero-content { position: relative; z-index: 1; max-width: 780px; }
.hero h1 {
  font-family: var(--font-serif);
  font-size: clamp(2.2rem, 5vw, 3.4rem);
  font-weight: 700;
  line-height: 1.5;
  margin-bottom: 1.5rem;
  letter-spacing: 0.06em;
}
.hero-sub {
  font-size: clamp(1rem, 2.5vw, 1.25rem);
  font-weight: 500;
  margin-bottom: 1.25rem;
  opacity: 0.95;
  letter-spacing: 0.04em;
}
.hero-lead {
  font-size: 0.95rem;
  line-height: 2;
  opacity: 0.85;
  max-width: 620px;
  margin: 0 auto;
  letter-spacing: 0.02em;
}

/* === VALUE PROPS === */
.value-props { background: var(--bg-white); padding: 80px 0; margin-top: -50px; position: relative; z-index: 2; }
.vp-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
.vp-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 40px 24px 36px;
  text-align: center;
  transition: all 0.3s ease;
}
.vp-card:hover { box-shadow: 0 12px 32px rgba(15,43,72,0.08); transform: translateY(-4px); border-color: transparent; }
.vp-icon {
  width: 56px; height: 56px;
  margin: 0 auto 20px;
  display: flex; align-items: center; justify-content: center;
}
.vp-icon svg { width: 40px; height: 40px; fill: none; stroke: var(--teal); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
.vp-card h3 { font-family: var(--font-serif); font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: 10px; letter-spacing: 0.03em; }
.vp-card p { font-size: 0.78rem; color: var(--text-sub); line-height: 1.7; letter-spacing: 0.01em; }

/* === ABOUT === */
.about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
.about-text h3 { font-family: var(--font-serif); font-size: 1.4rem; color: var(--navy); margin-bottom: 1.25rem; letter-spacing: 0.03em; line-height: 1.6; }
.about-text p { margin-bottom: 2rem; font-size: 0.92rem; color: var(--text-main); line-height: 2; letter-spacing: 0.01em; }
.bento-grid { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 220px 220px; gap: 12px; }
.bento-item { border-radius: 10px; overflow: hidden; position: relative; }
.bento-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
.bento-item:hover img { transform: scale(1.05); }
.bento-item:first-child { grid-column: span 2; }

/* === SERVICES === */
#services { background: var(--bg-warm); }
.services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-bottom: 2.5rem; }
.service-card { background: #fff; border-radius: 12px; overflow: hidden; transition: all 0.3s ease; border: 1px solid transparent; }
.service-card:hover { box-shadow: 0 12px 32px rgba(15,43,72,0.08); transform: translateY(-4px); border-color: var(--border); }
.service-img { height: 220px; overflow: hidden; }
.service-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
.service-card:hover .service-img img { transform: scale(1.05); }
.service-body { padding: 28px 24px; }
.service-body h3 { font-family: var(--font-serif); font-size: 1.1rem; color: var(--navy); margin-bottom: 10px; letter-spacing: 0.03em; }
.service-body p { font-size: 0.85rem; color: var(--text-sub); line-height: 1.8; }
.services-cta { text-align: center; margin-top: 2.5rem; }

/* === PRODUCTS === */
.products-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
.product-card { background: #fff; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; transition: all 0.3s ease; }
.product-card:hover { box-shadow: 0 12px 32px rgba(15,43,72,0.08); transform: translateY(-4px); border-color: transparent; }
.product-img { height: 200px; overflow: hidden; }
.product-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
.product-card:hover .product-img img { transform: scale(1.05); }
.product-body { padding: 24px 20px; }
.product-en { font-family: var(--font-en); font-size: 0.72rem; color: var(--teal); font-weight: 600; margin-bottom: 6px; letter-spacing: 0.5px; text-transform: uppercase; }
.product-body h3 { font-family: var(--font-serif); font-size: 0.95rem; color: var(--navy); margin-bottom: 8px; letter-spacing: 0.03em; }
.product-body p { font-size: 0.78rem; color: var(--text-sub); line-height: 1.7; margin-bottom: 14px; }
.product-link { font-size: 0.78rem; font-weight: 600; color: var(--navy); display: inline-flex; align-items: center; gap: 4px; letter-spacing: 0.02em; }
.product-link:hover { color: var(--teal); gap: 8px; }

/* === QUALITY === */
#quality { background: var(--bg-warm); }
.quality-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
.quality-img { border-radius: 12px; overflow: hidden; height: 440px; }
.quality-img img { width: 100%; height: 100%; object-fit: cover; }
.quality-items { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.qi-item { padding: 28px 24px; background: #fff; border-radius: 10px; border: 1px solid var(--border); transition: all 0.3s ease; }
.qi-item:hover { border-color: var(--teal); box-shadow: 0 4px 16px rgba(21,105,122,0.08); }
.qi-item h4 { font-family: var(--font-serif); font-size: 0.95rem; color: var(--navy); margin-bottom: 8px; letter-spacing: 0.03em; }
.qi-item p { font-size: 0.78rem; color: var(--text-sub); line-height: 1.7; }

/* === FAQ === */
.faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; max-width: 900px; margin: 0 auto; }
.faq-item { border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: #fff; transition: border-color 0.3s; }
.faq-item[open] { border-color: var(--teal); }
.faq-item summary {
  padding: 22px 28px;
  font-weight: 500;
  font-size: 0.88rem;
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  letter-spacing: 0.02em;
  transition: background 0.2s;
}
.faq-item summary:hover { background: var(--bg-cool); }
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item summary::after { content: '+'; font-size: 1.2rem; color: var(--teal); font-weight: 300; transition: transform 0.3s; }
.faq-item[open] summary::after { content: '−'; }
.faq-answer { padding: 0 28px 24px; font-size: 0.84rem; color: var(--text-sub); line-height: 1.9; letter-spacing: 0.01em; }

/* === NEWS === */
#news { background: var(--bg-warm); }
.news-list { max-width: 800px; margin: 0 auto; }
.news-item { display: flex; gap: 32px; padding: 20px 0; border-bottom: 1px solid var(--border); align-items: baseline; transition: background 0.2s; }
.news-item:hover { background: rgba(0,0,0,0.01); }
.news-date { font-family: var(--font-en); font-size: 0.82rem; color: var(--text-sub); white-space: nowrap; min-width: 130px; letter-spacing: 0.3px; }
.news-title { font-size: 0.9rem; color: var(--text-main); line-height: 1.7; letter-spacing: 0.01em; }
.news-cta { text-align: center; margin-top: 2.5rem; }

/* === FINANCIAL === */
.financial-box {
  max-width: 800px; margin: 0 auto;
  border: 2px dashed var(--border);
  border-radius: 12px;
  height: 320px;
  display: flex; align-items: center; justify-content: center;
  color: var(--text-sub); font-size: 0.88rem;
  background: var(--bg-white);
  letter-spacing: 0.02em;
}

/* === PRE-FOOTER CTA === */
.pre-footer { background: var(--navy); color: #fff; padding: 60px 0; }
.pre-footer-inner { display: flex; align-items: center; justify-content: space-between; max-width: 1000px; margin: 0 auto; padding: 0 24px; gap: 32px; flex-wrap: wrap; }
.pre-footer-text { font-family: var(--font-serif); font-size: 1.4rem; font-weight: 700; letter-spacing: 0.04em; line-height: 1.6; }
.pre-footer-btns { display: flex; gap: 16px; flex-wrap: wrap; }

/* === FOOTER === */
footer { background: var(--navy-dark); color: rgba(255,255,255,0.75); padding: 72px 0 28px; font-size: 0.78rem; letter-spacing: 0.01em; }
.footer-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; margin-bottom: 48px; }
.footer-col h4 { color: #fff; font-family: var(--font-serif); font-size: 0.9rem; margin-bottom: 20px; font-weight: 700; letter-spacing: 0.04em; }
.footer-col ul { list-style: none; }
.footer-col li { margin-bottom: 10px; }
.footer-col a { color: rgba(255,255,255,0.6); transition: color 0.2s; letter-spacing: 0.01em; }
.footer-col a:hover { color: #fff; }
.footer-contact p { margin-bottom: 8px; line-height: 1.7; }
.footer-contact strong { color: rgba(255,255,255,0.9); font-weight: 600; }
.footer-bottom { border-top: 1px solid rgba(255,255,255,0.08); padding-top: 28px; text-align: center; font-family: var(--font-en); font-size: 0.72rem; color: rgba(255,255,255,0.4); letter-spacing: 0.5px; }

/* === MOBILE === */
@media (max-width: 768px) {
  nav { display: none; }
  .mobile-toggle { display: block; }
  .vp-grid, .services-grid, .products-grid, .quality-items, .faq-grid, .footer-grid { grid-template-columns: 1fr; }
  .about-grid, .quality-grid { grid-template-columns: 1fr; }
  .hero { min-height: 520px; padding: 120px 20px 80px; }
  .hero h1 { font-size: 1.8rem; }
  .pre-footer-inner { flex-direction: column; text-align: center; }
  .bento-grid { grid-template-rows: 180px 180px; }
  section { padding: 64px 0; }
  .header-inner { padding: 0 16px; height: 64px; }
  .logo-mark { width: 36px; height: 36px; }
  .logo-mark span { font-size: 11px; }
  .quality-img { height: 300px; }
}
</style>
</head>
